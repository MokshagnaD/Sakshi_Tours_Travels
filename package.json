{
  "name": "sakshi-tours-fullstack",
  "version": "1.0.0",
  "description": "Sakshi Tours & Travels - Fullstack Application",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install --legacy-peer-deps",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "start:backend": "cd backend && npm start",
    "test:backend": "cd backend && node -c server.js",
    "test:frontend": "cd frontend && npm run build",
    "test": "npm run test:backend && npm run lint:frontend && npm run build:frontend"
  },
  "keywords": ["travel", "booking", "fullstack", "react", "express", "mongodb"],
  "author": "Sakshi Tours & Travels",
  "license": "MIT"
}